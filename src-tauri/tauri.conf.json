{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyLifeDock",
  "version": "../package.json",
  "identifier": "com.mylifedock.vault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MyLifeDock",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "visible": true,
        "focus": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://oauth2.googleapis.com https://www.googleapis.com https://script.google.com https://script.googleusercontent.com blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {},
    "externalBin": [],
    "copyright": "Copyright © 2026 MyLifeDock",
    "category": "Productivity",
    "shortDescription": "Privacy-first Personal Life Vault",
    "longDescription": "MyLifeDock is a secure, offline-first personal and family life management vault. Store documents, assets, finances, reminders and secrets with AES-256 encryption.",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
