{
  "$schema": "../node_modules/@tauri-apps/cli/schema/acl-schema.json",
  "identifier": "default",
  "description": "Default capability for MyLifeDock desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "fs:default",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default",
    "notification:allow-request-permission",
    "store:default",
    "store:allow-set",
    "store:allow-get",
    "store:allow-delete",
    "store:allow-save"
  ]
}
