# Build-time configuration. Copy to .env (never commit .env) and fill in.
# Google Drive backup is hidden on a platform until its client is configured.

# "Web application" OAuth client (Android Credential Manager uses it as the server client ID).
VITE_GOOGLE_CLIENT_ID=

# "iOS" OAuth client. Also add its reversed ID (com.googleusercontent.apps.XXXX)
# to CFBundleURLSchemes in ios/App/App/Info.plist; npm run release:check verifies this.
VITE_GOOGLE_IOS_CLIENT_ID=

# "Desktop app" OAuth client for the Windows app (system-browser sign-in with PKCE).
# Google treats an installed app's client secret as non-confidential.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
